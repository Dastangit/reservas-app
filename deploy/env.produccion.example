# Plantilla del .env del servidor (/opt/reservas/.env).
# desplegar.sh la sube la primera vez con JWT_SECRET y JWT_REFRESH_SECRET ya
# generados al azar. El resto se llena EN EL SERVIDOR con los valores que hoy
# tiene Render (Environment). Nunca pongas los valores reales en git ni en un chat.
# NODE_ENV y PORT los fija docker-compose.yml.

# Direccion publica del backend. La usa QvaPay para avisar de los pagos
# (`<API_URL>/api/webhooks/qvapay`). desplegar.sh la pone igual al dominio en cada despliegue.
API_URL=https://api.elysioexperiences.com

# Pagina publica (CORS y enlaces de los correos).
FRONTEND_URL=https://reservas-app-blue.vercel.app

# MongoDB Atlas. En Atlas -> Network Access, agrega la IP del VPS.
MONGODB_URI=

# Generados al azar por desplegar.sh. Si los cambias, todos tienen que volver a entrar.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

DEFAULT_TENANT_DOMAIN=elysioexperiences.com
EXPERIENCE_TIMEZONE=America/Havana

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

QVAPAY_APP_ID=
QVAPAY_APP_SECRET=
QVAPAY_API_URL=https://api.qvapay.com/v2

PAYPAL_MANUAL_USERNAME=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Avisos al admin por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry (opcional)
SENTRY_DSN=

# Secreto compartido con Vercel (mismo valor en Vercel y aqui): el limite de
# peticiones confia en la IP real del usuario solo si llega con el
# (utils/clientIp.js). Generar con: openssl rand -hex 32
PROXY_SECRET=
