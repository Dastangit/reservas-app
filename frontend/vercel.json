{
  "rewrites": [
    { "source": "/health", "destination": "https://booking-platform-f8co.onrender.com/health" },
    { "source": "/api/:path*", "destination": "https://booking-platform-f8co.onrender.com/api/:path*" },
    { "source": "/((?!api/)(?!.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</.well-known/api-catalog>; rel=\"api-catalog\"" }
      ]
    }
  ]
}
