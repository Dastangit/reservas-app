{
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://booking-platform-f8co.onrender.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://booking-platform-f8co.onrender.com/api/:path*"
    },
    {
      "source": "/:page(how-it-works|faq|terms|privacy)",
      "destination": "/prerendered/en/:page/index.html"
    },
    {
      "source": "/:lang(es|fr)",
      "destination": "/prerendered/:lang/index.html"
    },
    {
      "source": "/:lang(es|fr)/:page(how-it-works|faq|terms|privacy)",
      "destination": "/prerendered/:lang/:page/index.html"
    },
    {
      "source": "/((?!api/)(?!.*\\..*).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        }
      ]
    },
    {
      "source": "/(login|register|feedback)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(es|fr)/(login|register)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\""
        }
      ]
    }
  ]
}
