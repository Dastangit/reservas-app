# Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# MongoDB (obligatoria)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/reservas

# JWT (obligatorias, y distintas entre si)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# Tenant por defecto (dominio guardado en la coleccion tenants)
DEFAULT_TENANT_DOMAIN=elysioexperiences.com

# Zona horaria de las excursiones (la hora que escribe el organizador)
EXPERIENCE_TIMEZONE=America/Havana

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# QvaPay
QVAPAY_APP_ID=your-qvapay-app-id
QVAPAY_APP_SECRET=your-qvapay-app-secret
QVAPAY_API_URL=https://api.qvapay.com/v2

# PayPal manual (link a paypal.me, sin API)
PAYPAL_MANUAL_USERNAME=usuario-de-paypal-me

# Web Push para el admin
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Frontend URL (CORS y links de reset)
FRONTEND_URL=http://localhost:3000

# Sentry (opcional)
SENTRY_DSN=

# Solo para scripts/seed*.js (nunca en el servidor)
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_HOST_PASSWORD=
